# --- Database ---
POSTGRES_USER=leadbeast
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=leadbeast
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy / Procrastinate DSN (built from the above; override if needed)
DATABASE_URL=postgresql+psycopg://leadbeast:change-me-in-production@postgres:5432/leadbeast
PROCRASTINATE_DSN=postgresql://leadbeast:change-me-in-production@postgres:5432/leadbeast

# --- App ---
LB_ENV=dev
LB_SECRET_KEY=generate-a-random-32-byte-hex
LB_API_TOKEN=operator-token-change-me
LB_OPERATOR_EMAIL=you@example.com
LB_TIMEZONE=Asia/Karachi
LB_LOG_LEVEL=INFO
LB_DRY_RUN=true

# --- Cost caps (USD cents) ---
LB_CAP_PER_RUN=500
LB_CAP_PER_DAY=2000
LB_CAP_PER_MONTH=30000

# --- Adapters: ModelClient ---
# Default is `null` — a deterministic stub, works with no external services.
# Set to `ollama` once you've run an ollama container; `anthropic` with a key.
LB_MODEL_PROVIDER=null
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Adapters: Source (optional) ---
GOOGLE_PLACES_API_KEY=
OSM_USER_AGENT=leadbeast/0.1 (you@example.com)

# --- Adapters: Channel (email) ---
# `null` logs sends instead of mailing. Flip to `ses` or `listmonk` with creds.
LB_CHANNEL_PROVIDER=null
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=
LISTMONK_URL=
LISTMONK_USER=
LISTMONK_PASSWORD=

# --- Adapters: CRM ---
LB_CRM_PROVIDER=espo
ESPOCRM_URL=
ESPOCRM_API_KEY=

# --- Adapters: Dialer ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Maps ---
LB_MAP_PROVIDER=mapbox
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
